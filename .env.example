# Copy this file to .env and fill in what you have. Every var is optional --
# the tool degrades gracefully without any of them (lower rate limits / rule-based-only scoring).

# Optional: raises GitHub API rate limit from 60/hr to 5,000/hr. Create a free
# classic token with NO scopes checked (public read-only) at:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: free-tier LLM for narrative scoring. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: free-tier fallback LLM. Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Which provider to try first: "groq" | "gemini" | "none" (skip LLM narrative entirely)
LLM_PROVIDER=groq

# Cost/latency guardrails (defaults shown -- override only if you know why)
MAX_REPOS_PER_CANDIDATE=8
MAX_COMMITS_PER_REPO=100
